# Copy this file to `.env` and fill in your real values.
# `.env` is git-ignored and must never be committed.

# OpenAI-compatible API. Override the base URL if you route through a
# different OpenAI-compatible endpoint; the code reads these blindly.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Phoenix tracing collector endpoint. Leave as-is to use the built-in
# local app launched by px.launch_app(); set this to point at a running
# Phoenix instance instead.
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
